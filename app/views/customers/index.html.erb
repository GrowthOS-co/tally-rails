<% content_for :title, "Customers · Tally" %>

<div class="page-header">
  <h1>Customers</h1>
  <%= link_to "New customer", new_customer_path, class: "button button-primary" %>
</div>

<table class="table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Company</th>
      <th>Email</th>
    </tr>
  </thead>
  <tbody>
    <% @customers.each do |customer| %>
      <tr>
        <td><%= link_to customer.name, customer, class: "strong-link" %></td>
        <td><%= customer.company || "—" %></td>
        <td><%= customer.email %></td>
      </tr>
    <% end %>
  </tbody>
</table>
