<%= form_with model: customer, class: "form form-narrow" do |form| %>
  <%= render "shared/errors", record: customer %>

  <%= form.label :name, class: "field" do %>
    Name
    <%= form.text_field :name, required: true %>
  <% end %>

  <%= form.label :email, class: "field" do %>
    Email
    <%= form.email_field :email, required: true %>
  <% end %>

  <%= form.label :company, class: "field" do %>
    <span>Company <span class="muted">(optional)</span></span>
    <%= form.text_field :company %>
  <% end %>

  <%= form.submit submit_label, class: "button button-primary" %>
<% end %>
